@{
    ViewData["Title"] = "TeamFair - Đo đóng góp & Quản trị nhóm tự động";
}

<div class="container-fluid px-3 px-lg-4 py-3">
    <!-- Top Bar / App Brand -->
    <header class="d-flex flex-wrap align-items-center justify-content-between p-3 mb-3 bg-white rounded-4 shadow-sm border">
        <div class="d-flex align-items-center gap-3">
            <div style="font-size: 2.2rem; line-height: 1;" title="TeamFair Logo">🤝</div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h4 class="fw-bold text-slate-900 mb-0" style="letter-spacing: -0.5px;">TeamFair</h4>
                    <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1" style="font-size: 0.75rem;">Nền tảng Quản Trị Nhóm</span>
                </div>
                <div class="text-muted small mt-1" style="font-size: 0.825rem;">
                    Đo đóng góp nhóm tự động — số lượng lẫn chất lượng, không ai phải chấm điểm ai
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap mt-2 mt-md-0">
            <!-- Team Info & Join Code Badge -->
            <div class="px-3 py-1 bg-light rounded-3 border d-flex align-items-center gap-2" id="topTeamBadgeContainer">
                <span class="small text-muted">Nhóm:</span>
                <strong class="text-slate-900 small" id="topTeamName">Chưa có nhóm</strong>
                <button class="btn btn-sm btn-link p-0 text-decoration-none" onclick="TeamFairApp.editTeamInfo()" title="Chỉnh sửa thông tin nhóm">✏️</button>
            </div>

            <!-- Join Code Badge -->
            <span id="topJoinCodeBadge" class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 cursor-pointer d-none" onclick="TeamFairApp.copyJoinCode()" title="Bấm để sao chép mã mời nhóm">
                🔗 Mã: <strong id="topJoinCodeText">--</strong> 📋
            </span>

            <!-- Azure SQL Live Badge -->
            <span id="dbStatusBadge" class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.75rem;">
                🟢 Azure SQL: Đã kết nối
            </span>

            <!-- User Profile & Account Dropdown -->
            <div class="dropdown" id="userAccountDropdown">
                <button class="btn btn-sm btn-light border dropdown-toggle d-flex align-items-center gap-2 fw-semibold px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="userRoleBtn">
                    <span id="userAvatarBadge" class="tf-avatar" style="width: 24px; height: 24px; font-size: 0.7rem; background-color: #2563eb;">TV</span>
                    <span id="userNameDisplay">Thành Viên</span>
                    <span id="userRoleTag" class="badge bg-primary" style="font-size: 0.7rem;">🧑 Thành Viên</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border p-2" style="min-width: 260px;">
                    <li class="p-2 border-bottom mb-2">
                        <div class="small text-muted">Tài khoản đăng nhập:</div>
                        <strong class="text-slate-900" id="ddUserName">Thành Viên</strong>
                        <div class="small text-muted text-truncate" id="ddUserEmail">email@student.edu.vn</div>
                        <div class="small mt-1" id="ddUserRole">Vai trò: <span class="badge bg-primary" id="ddRoleBadge">Thành Viên</span></div>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-success fw-semibold" href="javascript:void(0)" onclick="TeamFairApp.openCreateTeamModal()">
                            <span>➕</span>
                            <span>Tạo nhóm mới <em>(Làm Nhóm Trưởng 👑)</em></span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-primary" href="javascript:void(0)" onclick="TeamFairApp.openJoinTeamModal()">
                            <span>🔗</span>
                            <span>Tham gia nhóm khác <em>(Bằng Mã Mời)</em></span>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-danger" href="javascript:void(0)" onclick="TeamFairApp.logout()">
                            <span>🚪</span>
                            <span>Đăng xuất tài khoản</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Direct Logout Button (Always Visible when logged in) -->
            <button class="btn btn-sm btn-outline-danger fw-semibold d-flex align-items-center gap-1" id="btnHeaderDirectLogout" onclick="TeamFairApp.logout()" title="Đăng xuất khỏi hệ thống">
                <span>🚪</span>
                <span>Đăng Xuất</span>
            </button>

            <!-- Login / Register button when not logged in -->
            <button class="btn btn-sm btn-primary d-none fw-semibold" id="btnHeaderLogin" onclick="TeamFairApp.showAuthPortal()">
                🔑 Đăng Nhập / Đăng Ký
            </button>

            <button class="btn btn-sm btn-outline-danger" onclick="TeamFairApp.clearAllData()" title="Xóa toàn bộ dữ liệu database để bắt đầu sạch sẽ">
                🗑️ Xóa làm mới
            </button>
            <button class="btn btn-sm btn-tf-primary text-white fw-bold d-flex align-items-center gap-1 shadow-sm px-3" id="btnHeaderReport" onclick="TeamFairApp.switchTab('report')" title="Báo cáo phân chia công việc & mức độ đóng góp (Primary Action)">
                <span>📄</span>
                <span>Báo Cáo Nộp Bài</span>
            </button>
        </div>
    </header>

    <!-- AUTH PORTAL VIEW (SHOWN WHEN USER IS NOT LOGGED IN) -->
    <div class="tf-auth-card d-none" id="authPortalView">
        <div class="tf-auth-header">
            <div style="font-size: 2.5rem; line-height: 1;" class="mb-2">🤝</div>
            <h4 class="fw-bold mb-1">Hệ Thống Phân Quyền & Quản Trị Nhóm TeamFair</h4>
            <div class="small opacity-90">Lưu trữ tài khoản & dữ liệu thực tế trên Azure SQL Database</div>
        </div>
        <div class="tf-auth-tabs">
            <button class="tf-auth-tab-btn active" id="btnAuthTabLogin" type="button" onclick="TeamFairApp.switchAuthTab('login')">🔑 Đăng Nhập</button>
            <button class="tf-auth-tab-btn" id="btnAuthTabRegister" type="button" onclick="TeamFairApp.switchAuthTab('register')">✨ Tạo Tài Khoản Mới</button>
        </div>
        <div class="p-4">
            <!-- Form 1: Login -->
            <form id="formUserLogin" onsubmit="event.preventDefault(); TeamFairApp.handleUserLogin();">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700">Email tài khoản:</label>
                    <input type="email" id="inputLoginEmail" class="form-control" placeholder="VD: an.nguyen@student.edu.vn" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700">Mật khẩu:</label>
                    <input type="password" id="inputLoginPassword" class="form-control" placeholder="Nhập mật khẩu của bạn..." required />
                </div>
                <div class="p-2 mb-3 bg-light rounded-3 border small text-muted">
                    📌 <em>Quy tắc phân quyền: Khi đăng nhập, ai cũng là <strong>Thành Viên</strong>. Khi bạn tự tạo nhóm mới, hệ thống sẽ set bạn làm <strong>Nhóm Trưởng</strong>!</em>
                </div>
                <button type="submit" class="btn btn-tf-primary text-white w-100 fw-bold py-2">
                    🔑 Đăng Nhập
                </button>

                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1 my-0 border-secondary-subtle">
                    <span class="px-2 small text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Hoặc</span>
                    <hr class="flex-grow-1 my-0 border-secondary-subtle">
                </div>

                <button type="button" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2 fw-semibold bg-white shadow-sm hover-shadow transition" onclick="TeamFairApp.handleGoogleAuthPrompt()">
                    <svg width="20" height="20" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span class="text-slate-800">Đăng nhập bằng tài khoản Google</span>
                </button>

                <div class="mt-2 text-center">
                    <button type="button" class="btn btn-sm btn-light border text-muted small py-1 px-3 w-100" onclick="TeamFairApp.handleGoogleLoginSubmit('kpham6488@gmail.com', 'Phạm Anh Khôi')">
                        ⚡ 1-Click nhanh: <strong>Phạm Anh Khôi</strong> (kpham6488@gmail.com)
                    </button>
                </div>

                <div class="text-center mt-3">
                    <span class="small text-muted">Chưa có tài khoản? </span>
                    <button type="button" class="btn btn-link p-0 small fw-semibold" onclick="TeamFairApp.switchAuthTab('register')">Đăng ký tài khoản mới</button>
                </div>
            </form>

            <!-- Form 2: Register -->
            <form id="formUserRegister" class="d-none" onsubmit="event.preventDefault(); TeamFairApp.handleUserRegister();">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700">Họ và Tên đầy đủ:</label>
                    <input type="text" id="inputRegName" class="form-control" placeholder="VD: Nguyễn Văn An" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700">Email sinh viên / cá nhân:</label>
                    <input type="email" id="inputRegEmail" class="form-control" placeholder="VD: an.nguyen@student.edu.vn" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700">Mật khẩu:</label>
                    <input type="password" id="inputRegPassword" class="form-control" placeholder="Mật khẩu tối thiểu 6 ký tự..." minlength="6" required />
                </div>
                <div class="p-2 mb-3 bg-light rounded-3 border small text-muted">
                    ✓ Dữ liệu tài khoản được lưu thật sự vào Azure SQL Database.<br>
                    ✓ Bạn có thể tự tạo nhóm mới để làm Nhóm Trưởng hoặc tham gia nhóm bạn bè.
                </div>
                <button type="submit" class="btn btn-tf-primary text-white w-100 fw-bold py-2">
                    ✨ Hoàn Tất Tạo Tài Khoản
                </button>

                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1 my-0 border-secondary-subtle">
                    <span class="px-2 small text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Hoặc</span>
                    <hr class="flex-grow-1 my-0 border-secondary-subtle">
                </div>

                <button type="button" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2 fw-semibold bg-white shadow-sm hover-shadow transition" onclick="TeamFairApp.handleGoogleAuthPrompt()">
                    <svg width="20" height="20" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span class="text-slate-800">Đăng ký nhanh bằng Google</span>
                </button>

                <div class="mt-2 text-center">
                    <button type="button" class="btn btn-sm btn-light border text-muted small py-1 px-3 w-100" onclick="TeamFairApp.handleGoogleLoginSubmit('kpham6488@gmail.com', 'Phạm Anh Khôi')">
                        ⚡ 1-Click nhanh: <strong>Phạm Anh Khôi</strong> (kpham6488@gmail.com)
                    </button>
                </div>

                <div class="text-center mt-3">
                    <span class="small text-muted">Đã có tài khoản rồi? </span>
                    <button type="button" class="btn btn-link p-0 small fw-semibold" onclick="TeamFairApp.switchAuthTab('login')">Quay lại Đăng nhập</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MAIN APP WORKSPACE VIEW (SHOWN WHEN USER IS LOGGED IN) -->
    <div id="mainAppWorkspaceView">
        <!-- Main Navigation Tabs - Fixed into 1 Single Line Row -->
        <nav class="tf-nav-tabs mb-4">
            <button class="tf-tab-btn active" data-tab="dashboard">
                <span>📊</span>
                <span id="tabDashboardTitle">Dashboard</span>
            </button>
            <button class="tf-tab-btn" data-tab="tasks">
                <span>📋</span>
                <span>Phân Chia Công Việc</span>
                <span class="badge bg-primary" id="badge-task-count">0/0</span>
            </button>
            <button class="tf-tab-btn" data-tab="schedule">
                <span>🗓️</span>
                <span>Lịch Rảnh Nhóm</span>
            </button>
            <button class="tf-tab-btn" data-tab="meeting">
                <span>📹</span>
                <span>Phòng Họp Ảo</span>
            </button>
            <button class="tf-tab-btn" data-tab="reviews">
                <span>⭐</span>
                <span>Đánh Giá Chéo</span>
            </button>
            <button class="tf-tab-btn" data-tab="emails">
                <span>✉️</span>
                <span>Thông Báo & Email</span>
                <span class="badge bg-danger" id="badge-email-count">0</span>
            </button>
        </nav>

        <!-- TAB 1: DASHBOARDS (2 DISTINCT DASHBOARDS) -->
        <div class="tf-tab-pane" id="pane-dashboard">
            <!-- ONBOARDING HUB VIEW (SHOWN WHEN NO TEAM HAS BEEN CREATED YET) -->
            <div id="teamHubView" class="mb-4 d-none">
                <div class="p-4 bg-white rounded-4 border shadow-sm mb-4 text-center">
                    <h4 class="fw-bold text-slate-900 mb-1">Xin chào, <span id="hubGreetingName">Bạn</span>! 👋</h4>
                    <div class="text-muted">Bạn hiện đang có vai trò <strong>🧑 Thành Viên</strong>. Để bắt đầu làm việc, hãy chọn một trong hai lựa chọn bên dưới:</div>
                </div>
                <div class="row g-4">
                    <!-- Option 1: Create New Team -->
                    <div class="col-lg-7">
                        <div class="tf-team-hub-card">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <span class="fs-1">👑</span>
                                <div>
                                    <h5 class="fw-bold text-slate-900 mb-1">Tạo Nhóm Mới (Bạn sẽ là Nhóm Trưởng)</h5>
                                    <div class="text-muted small">Hệ thống sẽ chỉ định bạn làm Nhóm Trưởng toàn quyền quản trị và cấp Mã Nhóm mời bạn bè.</div>
                                </div>
                            </div>
                            <form id="formHubCreateTeam" onsubmit="event.preventDefault(); TeamFairApp.handleCreateTeamHub();">
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-slate-700">Tên nhóm:</label>
                                    <input type="text" id="hubTeamName" class="form-control" placeholder="VD: Nhóm 05 - KTPM" required />
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold text-slate-700">Tên đề tài / Đồ án:</label>
                                        <input type="text" id="hubTeamTopic" class="form-control" placeholder="VD: Nền tảng quản trị phân công nhóm" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold text-slate-700">Môn học:</label>
                                        <input type="text" id="hubTeamSubject" class="form-control" placeholder="VD: Công nghệ phần mềm" />
                                    </div>
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold text-slate-700">Mã lớp / Giảng viên:</label>
                                        <input type="text" id="hubTeamClass" class="form-control" placeholder="VD: 21CNTT01 - ThS. Minh" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold text-slate-700">Hạn chót cuối kỳ:</label>
                                        <input type="date" id="hubTeamDeadline" class="form-control" />
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-tf-primary text-white w-100 fw-bold py-2">
                                    🚀 Tạo Nhóm Mới & Trở Thành Nhóm Trưởng
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Option 2: Join Existing Team -->
                    <div class="col-lg-5">
                        <div class="tf-team-hub-card">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <span class="fs-1">🧑</span>
                                <div>
                                    <h5 class="fw-bold text-slate-900 mb-1">Tham Gia Nhóm (Vai trò Thành Viên)</h5>
                                    <div class="text-muted small">Nhập mã nhóm do Nhóm Trưởng cung cấp (VD: TF-1234).</div>
                                </div>
                            </div>
                            <form id="formHubJoinTeam" onsubmit="event.preventDefault(); TeamFairApp.handleJoinTeamHub();">
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-slate-700">Mã nhóm mời (Join Code):</label>
                                    <input type="text" id="hubJoinCode" class="form-control text-uppercase fw-bold text-center" style="font-size: 1.25rem; letter-spacing: 2px;" placeholder="TF-xxxx" required />
                                </div>
                                <div class="p-3 bg-light rounded-3 small text-muted mb-4 border">
                                    ✓ Tham gia với tư cách <strong>Thành viên</strong>.<br>
                                    ✓ Nhận phân công nhiệm vụ, cập nhật tiến độ công việc và đánh giá chéo đồng đội.
                                </div>
                                <button type="submit" class="btn btn-outline-primary w-100 fw-bold py-2">
                                    🤝 Tham Gia Nhóm
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Role Indicator Banner (Active Team) -->
            <div class="alert d-flex flex-wrap align-items-center justify-content-between p-3 mb-4 rounded-3 shadow-sm" id="roleBanner" style="background: linear-gradient(135deg, #f0fdf4 0%, #e0f2fe 100%); border: 1px solid #bbf7d0;">
                <div class="d-flex align-items-center gap-3">
                    <span class="fs-3" id="roleBannerIcon">👑</span>
                    <div>
                        <h6 class="fw-bold text-slate-900 mb-0" id="roleBannerTitle">Bảng Điều Khiển Quản Trị - Nhóm Trưởng</h6>
                        <div class="small text-slate-600 mt-1" id="roleBannerDesc">
                            Bạn đang có quyền quản trị toàn diện: theo dõi chỉ số công bằng nhóm, giao việc, duyệt tiến độ và nhắc nhở thành viên.
                        </div>
                    </div>
                </div>
                <div class="mt-2 mt-md-0 d-flex gap-2 align-items-center">
                    <span id="bannerJoinCodeDisplay" class="badge bg-white text-primary border shadow-sm px-3 py-2 small fw-semibold">
                        Mã mời nhóm: <strong id="bannerJoinCodeText">TF-xxxx</strong>
                    </span>
                    <button class="btn btn-sm btn-outline-success fw-semibold" onclick="TeamFairApp.openCreateTeamModal()">
                        ➕ Tạo nhóm khác
                    </button>
                    <button class="btn btn-sm btn-outline-primary fw-semibold" id="btnSwitchOtherRole" onclick="TeamFairApp.toggleCurrentRole()">
                        🧑 Xem giao diện Thành Viên
                    </button>
                </div>
            </div>

        <!-- ==================== DASHBOARD 1: LEADER VIEW ==================== -->
        <div id="dash-leader-view">
            <!-- 4 Leader KPI Cards -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="tf-card p-3 h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="text-muted small fw-semibold text-uppercase">Tiến độ chung đồ án</div>
                                <h2 class="fw-bold text-slate-900 mt-2 mb-1" id="dash-kpi-progress">0%</h2>
                                <span class="small text-muted" id="dash-kpi-tasks">0 / 0 việc hoàn thành</span>
                            </div>
                            <div class="p-2 rounded-3 bg-primary-subtle text-primary fs-4">📈</div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="tf-card p-3 h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
