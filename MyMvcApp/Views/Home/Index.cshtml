@{
    ViewData["Title"] = "TeamFair - Quản lý tiến độ - Đánh giá công bằng - Tối ưu bài tập nhóm";
}

<div class="container-fluid px-3 px-lg-4 py-3">
    <!-- Top Bar / App Brand (Minimalist UX - Không xung đột nút bấm) -->
    <header class="d-flex flex-wrap align-items-center justify-content-between p-3 mb-3 bg-white rounded-3 shadow-sm border">
        <div class="d-flex align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h4 class="fw-bold text-slate-900 mb-0" style="letter-spacing: -0.5px;">TeamFair</h4>
                    <span class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1" style="font-size: 0.75rem;">Quản Lý & Nộp Bài Nhóm</span>
                </div>
                <div class="text-muted small mt-1" style="font-size: 0.8rem;">
                    Rõ việc • Đúng deadline • Nộp bài công bằng
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap mt-2 mt-md-0">
            <!-- Team Info & Join Code Badge -->
            <div class="px-3 py-1 bg-light rounded-3 border d-flex align-items-center gap-2" id="topTeamBadgeContainer">
                <span class="small text-muted">Nhóm:</span>
                <strong class="text-slate-900 small" id="topTeamName">Chưa có nhóm</strong>
                <button class="btn btn-sm btn-link p-0 text-decoration-none" onclick="TeamFairApp.editTeamInfo()" title="Chỉnh sửa thông tin nhóm">[Sửa]</button>
            </div>

            <!-- Join Code Badge -->
            <span id="topJoinCodeBadge" class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 cursor-pointer d-none" onclick="TeamFairApp.copyJoinCode()" title="Bấm để sao chép mã mời nhóm">
                Mã: <strong id="topJoinCodeText">--</strong> <span class="ms-1 text-decoration-underline">[Sao chép]</span>
            </span>

            <!-- Database Status Indicator -->
            <span id="dbStatusBadge" class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.75rem;">
                Đã kết nối
            </span>

            <!-- User Profile & Account Dropdown (Centralized Controls) -->
            <div class="dropdown" id="userAccountDropdown">
                <button class="btn btn-sm btn-light border dropdown-toggle d-flex align-items-center gap-2 fw-semibold px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="userRoleBtn">
                    <span id="userAvatarBadge" class="tf-avatar" style="width: 24px; height: 24px; font-size: 0.7rem; background-color: #2563eb;">TV</span>
                    <span id="userNameDisplay">Tài Khoản</span>
                    <span id="userRoleTag" class="badge bg-primary" style="font-size: 0.7rem;">Thành Viên</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border p-2" style="min-width: 260px;">
                    <li class="p-2 border-bottom mb-2 bg-light rounded-2">
                        <div class="small text-muted">Xin chào:</div>
                        <strong class="text-slate-900 d-block text-truncate" id="ddUserName">Thành Viên</strong>
                        <div class="small text-muted text-truncate" id="ddUserEmail">email@student.edu.vn</div>
                        <div class="small mt-1" id="ddUserRole">Vai trò: <span class="badge bg-primary" id="ddRoleBadge">Thành Viên</span></div>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-success fw-semibold" href="javascript:void(0)" onclick="TeamFairApp.openCreateTeamModal()">
                            <span>➕ Tạo nhóm mới <em>(Làm Nhóm Trưởng)</em></span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-primary" href="javascript:void(0)" onclick="TeamFairApp.openJoinTeamModal()">
                            <span>🔑 Tham gia nhóm khác <em>(Bằng Mã Mời)</em></span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-info" href="javascript:void(0)" onclick="TeamFairApp.loadDemoWorkspace()">
                            <span>⚡ Nạp dữ liệu mẫu <em>(Demo Workspace)</em></span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-secondary" href="javascript:void(0)" onclick="TeamFairApp.openOnboardingGuide()">
                            <span>📖 Xem hướng dẫn quy trình</span>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-warning" href="javascript:void(0)" onclick="TeamFairApp.clearAllData()">
                            <span>🧹 Dọn sạch dữ liệu nhóm</span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-danger fw-semibold" href="javascript:void(0)" onclick="TeamFairApp.logout()">
                            <span>🚪 Đăng xuất tài khoản</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Login / Register button when not logged in -->
            <button class="btn btn-sm btn-primary d-none fw-semibold" id="btnHeaderLogin" onclick="TeamFairApp.showAuthPortal()">
                Đăng Nhập / Đăng Ký
            </button>

            <!-- Hidden elements for backward compatibility with JS selectors -->
            <span id="btnHeaderDirectLogout" class="d-none"></span>
            <span id="btnHeaderReport" class="d-none"></span>
        </div>
    </header>

    <!-- AUTH PORTAL VIEW (SHOWN WHEN USER IS NOT LOGGED IN) -->
    <div class="tf-auth-card d-none" id="authPortalView">
        <div class="tf-auth-header">
            
            <h4 class="fw-bold mb-1">Hệ Thống Phân Quyền & Quản Trị Nhóm TeamFair</h4>
            <div class="small opacity-90">Lưu trữ tài khoản & dữ liệu thực tế trên Azure SQL Database</div>
        </div>
        <div class="tf-auth-tabs">
            <button class="tf-auth-tab-btn active" id="btnAuthTabLogin" type="button" onclick="TeamFairApp.switchAuthTab('login')">Đăng Nhập</button>
            <button class="tf-auth-tab-btn" id="btnAuthTabRegister" type="button" onclick="TeamFairApp.switchAuthTab('register')">Tạo Tài Khoản Mới</button>
        </div>
        <div class="p-4">
            <!-- Form 1: Login -->
            <form id="formUserLogin" onsubmit="event.preventDefault(); TeamFairApp.handleUserLogin();">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700">Email tài khoản:</label>
                    <input type="email" id="inputLoginEmail" class="form-control" placeholder="VD: an.nguyen@student.edu.vn" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700">Mật khẩu:</label>
                    <input type="password" id="inputLoginPassword" class="form-control" placeholder="Nhập mật khẩu của bạn..." required />
                </div>
                <div class="p-2 mb-3 bg-light rounded-3 border small text-muted">
                    <em>Quy tắc phân quyền: Khi đăng nhập, ai cũng là <strong>Thành Viên</strong>. Khi bạn tự tạo nhóm mới, hệ thống sẽ set bạn làm <strong>Nhóm Trưởng</strong>!</em>
                </div>
                <button type="submit" class="btn btn-tf-primary text-white w-100 fw-bold py-2">
                    Đăng Nhập
                </button>

                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1 my-0 border-secondary-subtle">
                    <span class="px-2 small text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Hoặc</span>
                    <hr class="flex-grow-1 my-0 border-secondary-subtle">
                </div>

                <a href="/auth/google-login" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2 fw-semibold bg-white shadow-sm hover-shadow transition text-decoration-none">
                    <svg width="20" height="20" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span class="text-slate-800">Đăng nhập trực tiếp bằng Google</span>
                </a>

                <div class="mt-2 text-center d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-light border text-muted small py-1 px-2 flex-grow-1" onclick="TeamFairApp.handleGoogleLoginSubmit('kpham6488@gmail.com', 'Phạm Anh Khôi')">
                        1-Click: <strong>Phạm Anh Khôi</strong>
                    </button>
                    <button type="button" class="btn btn-sm btn-light border text-muted small py-1 px-2" onclick="TeamFairApp.openGoogleModalManual()" title="Chọn hoặc nhập tài khoản Google khác">
                        Khác
                    </button>
                </div>

                <div class="text-center mt-3">
                    <span class="small text-muted">Chưa có tài khoản? </span>
                    <button type="button" class="btn btn-link p-0 small fw-semibold" onclick="TeamFairApp.switchAuthTab('register')">Đăng ký tài khoản mới</button>
                </div>
            </form>

            <!-- Form 2: Register -->
            <form id="formUserRegister" class="d-none" onsubmit="event.preventDefault(); TeamFairApp.handleUserRegister();">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700">Họ và Tên đầy đủ:</label>
                    <input type="text" id="inputRegName" class="form-control" placeholder="VD: Nguyễn Văn An" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700">Email sinh viên / cá nhân:</label>
                    <input type="email" id="inputRegEmail" class="form-control" placeholder="VD: an.nguyen@student.edu.vn" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700">Mật khẩu:</label>
                    <input type="password" id="inputRegPassword" class="form-control" placeholder="Mật khẩu tối thiểu 6 ký tự..." minlength="6" required />
                </div>
                <div class="p-2 mb-3 bg-light rounded-3 border small text-muted">
                    ✓ Dữ liệu tài khoản được lưu thật sự vào Azure SQL Database.<br>
                    ✓ Bạn có thể tự tạo nhóm mới để làm Nhóm Trưởng hoặc tham gia nhóm bạn bè.
                </div>
                <button type="submit" class="btn btn-tf-primary text-white w-100 fw-bold py-2">
                    Hoàn Tất Tạo Tài Khoản
                </button>

                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1 my-0 border-secondary-subtle">
                    <span class="px-2 small text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Hoặc</span>
                    <hr class="flex-grow-1 my-0 border-secondary-subtle">
                </div>

                <a href="/auth/google-login" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2 fw-semibold bg-white shadow-sm hover-shadow transition text-decoration-none">
                    <svg width="20" height="20" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span class="text-slate-800">Đăng ký nhanh bằng Google</span>
                </a>

                <div class="mt-2 text-center d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-light border text-muted small py-1 px-2 flex-grow-1" onclick="TeamFairApp.handleGoogleLoginSubmit('kpham6488@gmail.com', 'Phạm Anh Khôi')">
                        1-Click: <strong>Phạm Anh Khôi</strong>
                    </button>
                    <button type="button" class="btn btn-sm btn-light border text-muted small py-1 px-2" onclick="TeamFairApp.openGoogleModalManual()" title="Chọn hoặc nhập tài khoản Google khác">
                        Khác
                    </button>
                </div>

                <div class="text-center mt-3">
                    <span class="small text-muted">Đã có tài khoản rồi? </span>
                    <button type="button" class="btn btn-link p-0 small fw-semibold" onclick="TeamFairApp.switchAuthTab('login')">Quay lại Đăng nhập</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MAIN APP WORKSPACE VIEW (SHOWN WHEN USER IS LOGGED IN) -->
    <div id="mainAppWorkspaceView" class="tf-workspace-layout">
        <!-- Vertical Sidebar Navigation on the Left -->
        <aside class="tf-sidebar">
            <div class="tf-sidebar-header">
                <span class="small fw-bold text-uppercase text-muted" style="letter-spacing: 0.5px; font-size: 0.72rem;">Điều hướng</span>
            </div>
            <nav class="tf-nav-tabs">
                <button class="tf-tab-btn active" data-tab="dashboard">
                    <span class="tf-tab-icon">📊</span>
                    <span id="tabDashboardTitle" class="tf-tab-text">Dashboard</span>
                </button>
                <button class="tf-tab-btn" data-tab="tasks">
                    <span class="tf-tab-icon">📋</span>
                    <span class="tf-tab-text">Phân Chia Việc</span>
                    <span class="badge bg-primary" id="badge-task-count">0/0</span>
                </button>
                <button class="tf-tab-btn" data-tab="schedule">
                    <span class="tf-tab-icon">📅</span>
                    <span class="tf-tab-text">Lịch Rảnh Nhóm</span>
                </button>
                <button class="tf-tab-btn" data-tab="meeting">
                    <span class="tf-tab-icon">📹</span>
                    <span class="tf-tab-text">Phòng Họp Ảo</span>
                </button>
                <button class="tf-tab-btn" data-tab="reviews">
                    <span class="tf-tab-icon">⭐</span>
                    <span class="tf-tab-text">Đánh Giá Chéo</span>
                </button>
                <button class="tf-tab-btn" data-tab="emails">
                    <span class="tf-tab-icon">🔔</span>
                    <span class="tf-tab-text">Thông Báo & Mail</span>
                    <span class="badge bg-danger" id="badge-email-count">0</span>
                </button>

                <!-- When2meet Scheduler Tool Link -->
                <div class="pt-2 mt-2 border-top w-100">
                    <a href="/event" class="tf-tab-btn text-decoration-none w-100 d-flex align-items-center" style="background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d;" title="Tạo khảo sát When2meet">
                        <span class="tf-tab-icon">🚀</span>
                        <span class="tf-tab-text fw-bold">When2meet</span>
                    </a>
                </div>
            </nav>
        </aside>

        <!-- Main Content Workspace on the Right -->
        <main class="tf-main-content">

        <!-- TAB 1: DASHBOARDS (2 DISTINCT DASHBOARDS) -->
        <div class="tf-tab-pane" id="pane-dashboard">
            <!-- ONBOARDING HUB VIEW (SHOWN WHEN NO TEAM HAS BEEN CREATED YET) -->
            <div id="teamHubView" class="mb-4 d-none">
                <!-- Welcome & Guide Banner -->
                <div class="p-4 bg-white rounded-4 border shadow-sm mb-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <h4 class="fw-bold text-slate-900 mb-1">Xin chào, <span id="hubGreetingName">Bạn</span>!</h4>
                            <div class="text-muted">Chào mừng bạn đến với TeamFair. Chọn một trong các cách bên dưới để bắt đầu làm việc ngay:</div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary fw-semibold btn-sm d-flex align-items-center gap-2" onclick="TeamFairApp.openOnboardingGuide()">
                                
                                <span>Xem Hướng Dẫn Quy Trình</span>
                            </button>
                            <button class="btn btn-tf-indigo text-white fw-semibold btn-sm d-flex align-items-center gap-2" onclick="TeamFairApp.loadDemoWorkspace()">
                                
                                <span>Trải Nghiệm Dữ Liệu Mẫu (Demo)</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Option 1: Create New Team -->
                    <div class="col-lg-4">
                        <div class="tf-team-hub-card d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <span class="fs-1"></span>
                                    <div>
                                        <h5 class="fw-bold text-slate-900 mb-1">Tạo Nhóm Mới</h5>
                                        <div class="text-muted small">Bạn sẽ là <strong>Nhóm Trưởng</strong> quản trị toàn diện.</div>
                                    </div>
                                </div>
                                <form id="formHubCreateTeam" onsubmit="event.preventDefault(); TeamFairApp.handleCreateTeamHub();">
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold text-slate-700">Tên nhóm:</label>
                                        <input type="text" id="hubTeamName" class="form-control" placeholder="VD: Nhóm 05 - KTPM" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold text-slate-700">Đề tài đồ án:</label>
                                        <input type="text" id="hubTeamTopic" class="form-control" placeholder="VD: Ứng dụng quản trị nhóm" />
                                    </div>
                                    <div class="row g-2 mb-3">
                                        <div class="col-6">
                                            <label class="form-label small fw-semibold text-slate-700">Môn học:</label>
                                            <input type="text" id="hubTeamSubject" class="form-control" placeholder="VD: CNTT" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small fw-semibold text-slate-700">Hạn chót:</label>
                                            <input type="date" id="hubTeamDeadline" class="form-control" />
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-tf-primary text-white w-100 fw-bold py-2 mt-2">
                                        Tạo Nhóm Mới
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Option 2: Join Existing Team -->
                    <div class="col-lg-4">
                        <div class="tf-team-hub-card d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <span class="fs-1"></span>
                                    <div>
                                        <h5 class="fw-bold text-slate-900 mb-1">Tham Gia Nhóm</h5>
                                        <div class="text-muted small">Gia nhập với vai trò <strong>Thành Viên</strong>.</div>
                                    </div>
                                </div>
                                <form id="formHubJoinTeam" onsubmit="event.preventDefault(); TeamFairApp.handleJoinTeamHub();">
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold text-slate-700">Mã nhóm mời (Join Code):</label>
                                        <input type="text" id="hubJoinCode" class="form-control text-uppercase fw-bold text-center" style="font-size: 1.25rem; letter-spacing: 2px;" placeholder="TF-xxxx" required />
                                    </div>
                                    <div class="p-3 bg-light rounded-3 small text-muted mb-4 border">
                                        ✓ Nhận phân công nhiệm vụ từ Nhóm Trưởng.<br>
                                        ✓ Cập nhật tiến độ qua Kanban, xếp lịch rảnh & chấm điểm chéo.
                                    </div>
                                    <button type="submit" class="btn btn-outline-primary w-100 fw-bold py-2">
                                        Tham Gia Nhóm
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Option 3: Demo Workspace (Requirement 6) -->
                    <div class="col-lg-4">
                        <div class="tf-team-hub-card d-flex flex-column justify-content-between border-primary shadow-sm" style="background: linear-gradient(180deg, #ffffff 0%, #f0fdf4 100%);">
                            <div>
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <span class="fs-1"></span>
                                    <div>
                                        <h5 class="fw-bold text-slate-900 mb-1">Dữ Liệu Mẫu (Demo)</h5>
                                        <div class="text-success small fw-semibold">1-Click Trải Nghiệm Toàn Diện</div>
                                    </div>
                                </div>
                                <p class="small text-slate-600 mb-3">
                                    Bạn là người dùng mới hoặc chưa có nhóm thực tế? Nạp ngay nhóm mẫu 4 sinh viên để trải nghiệm thực tế:
                                </p>
                                <ul class="small text-muted ps-3 mb-3">
                                    <li>Đã có 4 thành viên phân chia vai trò rõ ràng</li>
                                    <li>6 nhiệm vụ trên bảng Kanban đầy đủ trạng thái</li>
                                    <li>Lịch rảnh & khung giờ họp nhóm được tối ưu</li>
