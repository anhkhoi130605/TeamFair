                                <div class="input-group">
                                    <input type="text" id="meetingChatInput" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Nhập tin nhắn..." onkeypress="if(event.key==='Enter') TeamFairApp.sendMeetingChat()" />
                                    <button class="btn btn-sm btn-primary" onclick="TeamFairApp.sendMeetingChat()">Gửi</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: ĐÁNH GIÁ CHÉO (PEER REVIEW MODAL) -->
<div class="modal fade" id="peerReviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-slate-900">⭐ Đánh Giá Chéo Công Việc Đồng Đội</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="reviewTaskId" />

                <div class="p-3 bg-light rounded-3 mb-3 border">
                    <div class="small text-muted">Công việc đánh giá:</div>
                    <div class="fw-bold text-slate-900" id="reviewTaskTitleDisplay">Tên công việc</div>
                    <div class="small text-muted mt-1">Người thực hiện: <strong class="text-primary" id="revieweeNameDisplay">Tên</strong></div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700">Bạn là ai (Người đánh giá):</label>
                    <select id="reviewerSelect" class="form-select form-select-sm">
                        <!-- Populated by JS -->
                    </select>
                </div>

                <!-- 4 Criteria Ratings -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700 d-block">1. Chất lượng sản phẩm & đúng yêu cầu (1-5 ⭐):</label>
                    <div class="star-rating">
                        <input type="radio" id="q5" name="rateQuality" value="5" checked><label for="q5">★</label>
                        <input type="radio" id="q4" name="rateQuality" value="4"><label for="q4">★</label>
                        <input type="radio" id="q3" name="rateQuality" value="3"><label for="q3">★</label>
                        <input type="radio" id="q2" name="rateQuality" value="2"><label for="q2">★</label>
                        <input type="radio" id="q1" name="rateQuality" value="1"><label for="q1">★</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700 d-block">2. Đúng tiến độ / Deadline (1-5 ⭐):</label>
                    <div class="star-rating">
                        <input type="radio" id="p5" name="ratePunctuality" value="5" checked><label for="p5">★</label>
                        <input type="radio" id="p4" name="ratePunctuality" value="4"><label for="p4">★</label>
                        <input type="radio" id="p3" name="ratePunctuality" value="3"><label for="p3">★</label>
                        <input type="radio" id="p2" name="ratePunctuality" value="2"><label for="p2">★</label>
                        <input type="radio" id="p1" name="ratePunctuality" value="1"><label for="p1">★</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700 d-block">3. Độ khó & Nỗ lực bỏ ra (1-5 ⭐):</label>
                    <div class="star-rating">
                        <input type="radio" id="e5" name="rateEffort" value="5" checked><label for="e5">★</label>
                        <input type="radio" id="e4" name="rateEffort" value="4"><label for="e4">★</label>
                        <input type="radio" id="e3" name="rateEffort" value="3"><label for="e3">★</label>
                        <input type="radio" id="e2" name="rateEffort" value="2"><label for="e2">★</label>
                        <input type="radio" id="e1" name="rateEffort" value="1"><label for="e1">★</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700 d-block">4. Tinh thần hợp tác & phản hồi (1-5 ⭐):</label>
                    <div class="star-rating">
                        <input type="radio" id="c5" name="rateCooperation" value="5" checked><label for="c5">★</label>
                        <input type="radio" id="c4" name="rateCooperation" value="4"><label for="c4">★</label>
                        <input type="radio" id="c3" name="rateCooperation" value="3"><label for="c3">★</label>
                        <input type="radio" id="c2" name="rateCooperation" value="2"><label for="c2">★</label>
                        <input type="radio" id="c1" name="rateCooperation" value="1"><label for="c1">★</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-slate-700">Lời góp ý mang tính xây dựng:</label>
                    <textarea id="reviewComment" class="form-control" rows="2" placeholder="Nhận xét cụ thể điểm làm tốt và điểm cần cải thiện..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-tf-primary text-white" onclick="TeamFairApp.submitPeerReview()">Gửi Đánh Giá</button>
            </div>
        </div>
    </div>
</div>

