@{
    ViewData["Title"] = "TeamFair - Quản lý tiến độ - Đánh giá công bằng - Tối ưu bài tập nhóm";
}

<!-- ==========================================================================
     AUTH PORTAL VIEW (CENTERED CARD - SHOWN WHEN USER IS NOT LOGGED IN)
     ========================================================================== -->
<div class="tf-auth-wrapper d-none" id="authPortalWrapper">
    <div class="tf-auth-card" id="authPortalView">
        <div class="tf-auth-header">
            <div class="d-inline-flex align-items-center justify-content-center mb-3">
                <div class="tf-rail-logo" style="width: 48px; height: 48px; font-size: 1.25rem;">TF</div>
            </div>
            <h4 class="fw-bold text-main mb-1">Hệ Thống Quản Trị Nhóm TeamFair</h4>
            <div class="text-secondary-tf small">Lưu trữ tài khoản & dữ liệu thời gian thực trên Azure SQL Database</div>
        </div>
        <div class="tf-auth-tabs">
            <button class="tf-auth-tab-btn active" id="btnAuthTabLogin" type="button" onclick="TeamFairApp.switchAuthTab('login')">Đăng Nhập</button>
            <button class="tf-auth-tab-btn" id="btnAuthTabRegister" type="button" onclick="TeamFairApp.switchAuthTab('register')">Tạo Tài Khoản Mới</button>
        </div>
        <div class="p-4">
            <!-- Form 1: Login -->
            <form id="formUserLogin" onsubmit="event.preventDefault(); TeamFairApp.handleUserLogin();">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary-tf">Email tài khoản:</label>
                    <input type="email" id="inputLoginEmail" class="form-control" placeholder="VD: an.nguyen@student.edu.vn" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary-tf">Mật khẩu:</label>
                    <input type="password" id="inputLoginPassword" class="form-control" placeholder="Nhập mật khẩu của bạn..." required />
                </div>
                <div class="p-3 mb-3 bg-light rounded-3 small text-secondary-tf border">
                    Quy tắc phân quyền: Khi đăng nhập, mặc định bạn là <strong>Thành Viên</strong>. Khi bạn tự tạo nhóm mới, hệ thống sẽ gán bạn làm <strong>Nhóm Trưởng</strong>!
                </div>
                <button type="submit" class="btn btn-tf-primary text-white w-100 fw-bold py-2">
                    Đăng Nhập
                </button>

                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1 my-0 border-secondary-subtle">
                    <span class="px-2 small text-secondary-tf text-uppercase fw-semibold" style="font-size: 0.75rem;">Hoặc</span>
                    <hr class="flex-grow-1 my-0 border-secondary-subtle">
                </div>

                <a href="/auth/google-login" class="btn-google-auth">
                    <svg width="20" height="20" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Đăng nhập trực tiếp bằng Google</span>
                </a>

                <div class="mt-2 text-center d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-light border text-secondary-tf small py-1 px-2 flex-grow-1" onclick="TeamFairApp.handleGoogleLoginSubmit('kpham6488@gmail.com', 'Phạm Anh Khôi')">
                        1-Click: <strong>Phạm Anh Khôi</strong>
                    </button>
                    <button type="button" class="btn btn-sm btn-light border text-secondary-tf small py-1 px-2" onclick="TeamFairApp.openGoogleModalManual()" title="Chọn hoặc nhập tài khoản Google khác">
                        Khác
                    </button>
                </div>

                <div class="mt-2">
                    <button type="button" class="btn btn-sm btn-tf-outline w-100 py-1 fw-semibold text-purple" onclick="TeamFairApp.loadDemoWorkspace()">
                        ⚡ Trải nghiệm ngay bản Demo (Đầy đủ dữ liệu mẫu)
                    </button>
                </div>

                <div class="text-center mt-3">
                    <span class="small text-secondary-tf">Chưa có tài khoản? </span>
                    <button type="button" class="btn btn-link p-0 small fw-semibold text-purple" onclick="TeamFairApp.switchAuthTab('register')">Đăng ký tài khoản mới</button>
                </div>
            </form>

            <!-- Form 2: Register -->
            <form id="formUserRegister" class="d-none" onsubmit="event.preventDefault(); TeamFairApp.handleUserRegister();">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary-tf">Họ và Tên đầy đủ:</label>
                    <input type="text" id="inputRegName" class="form-control" placeholder="VD: Nguyễn Văn An" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary-tf">Email sinh viên / cá nhân:</label>
                    <input type="email" id="inputRegEmail" class="form-control" placeholder="VD: an.nguyen@student.edu.vn" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary-tf">Mật khẩu:</label>
                    <input type="password" id="inputRegPassword" class="form-control" placeholder="Mật khẩu tối thiểu 6 ký tự..." minlength="6" required />
                </div>
                <div class="p-3 mb-3 bg-light rounded-3 small text-secondary-tf border">
                    ✓ Dữ liệu tài khoản được lưu trữ an toàn trong Azure SQL Database.<br>
                    ✓ Tự do tạo nhóm mới hoặc tham gia nhóm có sẵn bất kỳ lúc nào.
                </div>
                <button type="submit" class="btn btn-tf-primary text-white w-100 fw-bold py-2">
                    Hoàn Tất Tạo Tài Khoản
                </button>

                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1 my-0 border-secondary-subtle">
                    <span class="px-2 small text-secondary-tf text-uppercase fw-semibold" style="font-size: 0.75rem;">Hoặc</span>
                    <hr class="flex-grow-1 my-0 border-secondary-subtle">
                </div>

                <a href="/auth/google-login" class="btn-google-auth">
                    <svg width="20" height="20" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Đăng ký nhanh bằng Google</span>
                </a>

                <div class="text-center mt-3">
                    <span class="small text-secondary-tf">Đã có tài khoản rồi? </span>
                    <button type="button" class="btn btn-link p-0 small fw-semibold text-purple" onclick="TeamFairApp.switchAuthTab('login')">Quay lại Đăng nhập</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ==========================================================================
     MAIN APP WORKSPACE VIEW (GEEKBOT 3-ZONE LAYOUT - SHOWN WHEN LOGGED IN)
     ========================================================================== -->
<div class="tf-app-wrapper" id="mainAppWorkspaceView">

    <!-- ==================== ZONE 1: ICON RAIL (68px FIXED LEFT) ==================== -->
    <aside class="tf-icon-rail" id="iconRail">
        <!-- Top TF Logo -->
        <div class="tf-rail-top">
            <div class="tf-rail-logo" onclick="TeamFairApp.switchTab('dashboard')" title="TeamFair Dashboard">TF</div>
        </div>

        <!-- Main Group Outline Icons -->
        <div class="tf-rail-nav">
            <!-- 1. Dashboard -->
            <button class="tf-rail-btn tf-tab-btn active" data-tab="dashboard" data-bs-toggle="tooltip" data-bs-placement="right" title="Dashboard">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                    <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                </svg>
            </button>

            <!-- 2. Phân Chia Việc -->
            <button class="tf-rail-btn tf-tab-btn" data-tab="tasks" data-bs-toggle="tooltip" data-bs-placement="right" title="Phân Chia Việc">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 11l3 3L22 4"></path>
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                </svg>
                <span class="tf-rail-badge" id="badge-task-count">0/0</span>
            </button>

            <!-- 3. Lịch Rảnh Nhóm -->
            <button class="tf-rail-btn tf-tab-btn" data-tab="schedule" data-bs-toggle="tooltip" data-bs-placement="right" title="Lịch Rảnh Nhóm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </button>

            <!-- 4. Phòng Họp Ảo -->
            <button class="tf-rail-btn tf-tab-btn" data-tab="meeting" data-bs-toggle="tooltip" data-bs-placement="right" title="Phòng Họp Ảo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="23 7 16 12 23 17 23 7"></polygon>
                    <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                </svg>
            </button>

            <!-- 5. Đánh Giá Chéo -->
            <button class="tf-rail-btn tf-tab-btn" data-tab="reviews" data-bs-toggle="tooltip" data-bs-placement="right" title="Đánh Giá Chéo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
            </button>

            <!-- 6. Thông Báo & Mail -->
            <button class="tf-rail-btn tf-tab-btn" data-tab="emails" data-bs-toggle="tooltip" data-bs-placement="right" title="Thông Báo & Mail">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <span class="tf-rail-badge tf-rail-badge-danger" id="badge-email-count">0</span>
            </button>

            <!-- 7. When2meet Link -->
            <a href="/event" class="tf-rail-btn" data-bs-toggle="tooltip" data-bs-placement="right" title="When2meet (Khảo sát thời gian)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
            </a>
        </div>

        <!-- Spacer -->
        <div class="tf-rail-spacer"></div>

        <!-- Secondary Bottom Group -->
        <div class="tf-rail-bottom">
            <!-- Báo cáo nộp bài -->
            <button class="tf-rail-btn tf-tab-btn" data-tab="report" data-bs-toggle="tooltip" data-bs-placement="right" title="Báo Cáo Nộp Bài">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
            </button>

            <!-- Hướng dẫn quy trình -->
            <button class="tf-rail-btn" onclick="TeamFairApp.openOnboardingGuide()" data-bs-toggle="tooltip" data-bs-placement="right" title="Hướng Dẫn Vận Hành Nhóm Đồ Án">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </button>
        </div>

        <!-- Bottom User Avatar & Account Menu -->
        <div class="tf-rail-user">
            <div class="dropdown dropend" id="userAccountDropdown">
                <button class="tf-avatar-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="userRoleBtn" title="Tài khoản">
                    <span id="userAvatarBadge" class="tf-avatar-circle">TV</span>
                </button>
                <ul class="dropdown-menu shadow-lg border-0 p-2" style="min-width: 260px; border-radius: 12px;">
                    <li class="p-2 border-bottom mb-2 bg-light rounded-2">
                        <div class="small text-secondary-tf">Xin chào:</div>
                        <strong class="text-main d-block text-truncate" id="ddUserName">Thành Viên</strong>
                        <div class="small text-secondary-tf text-truncate" id="ddUserEmail">email@student.edu.vn</div>
                        <div class="small mt-1" id="ddUserRole">Vai trò: <span class="badge bg-primary" id="ddRoleBadge">Thành Viên</span></div>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-success fw-semibold" href="javascript:void(0)" onclick="TeamFairApp.openCreateTeamModal()">
                            <span>➕ Tạo nhóm mới <em>(Làm Nhóm Trưởng)</em></span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-primary" href="javascript:void(0)" onclick="TeamFairApp.openJoinTeamModal()">
                            <span>🔑 Tham gia nhóm khác <em>(Bằng Mã Mời)</em></span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-info" href="javascript:void(0)" onclick="TeamFairApp.loadDemoWorkspace()">
                            <span>⚡ Nạp dữ liệu mẫu <em>(Demo Workspace)</em></span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-secondary" href="javascript:void(0)" onclick="TeamFairApp.openOnboardingGuide()">
                            <span>📖 Xem hướng dẫn quy trình</span>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-warning" href="javascript:void(0)" onclick="TeamFairApp.clearAllData()">
                            <span>🧹 Dọn sạch dữ liệu nhóm</span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item rounded-2 py-2 small d-flex align-items-center gap-2 text-danger fw-semibold" href="javascript:void(0)" onclick="TeamFairApp.logout()">
                            <span>🚪 Đăng xuất tài khoản</span>
                        </a>
                    </li>
                </ul>
            </div>

            <button class="btn btn-sm tf-login-rail-btn d-none" id="btnHeaderLogin" onclick="TeamFairApp.showAuthPortal()" title="Đăng Nhập">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                    <polyline points="10 17 15 12 10 7"></polyline>
                    <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
            </button>

            <!-- Hidden placeholders for backward compatibility with JS queries -->
            <span id="userNameDisplay" class="d-none"></span>
            <span id="userRoleTag" class="d-none"></span>
            <span id="tabDashboardTitle" class="d-none">Dashboard</span>
            <span id="btnHeaderDirectLogout" class="d-none"></span>
            <span id="btnHeaderReport" class="d-none"></span>
        </div>
    </aside>

    <!-- ==================== ZONE 2: SECONDARY CATEGORY RAIL (224px) ==================== -->
    <aside class="tf-subrail d-none" id="secondaryCategoryRail">
        <!-- Section for Tasks -->
        <div class="tf-subrail-section" id="subrail-tasks">
            <div class="tf-subrail-header">Trạng thái</div>
            <div class="tf-subrail-group" id="subrailTaskStatusGroup">
                <!-- Populated dynamically: Tất cả, Chưa bắt đầu, Đang làm, Chờ đánh giá, Đã hoàn thành -->
            </div>
            <div class="tf-subrail-header mt-3">Thành viên</div>
            <div class="tf-subrail-group" id="subrailTaskMemberGroup">
                <!-- Populated dynamically: Tất cả + từng thành viên -->
            </div>
        </div>

        <!-- Section for Emails -->
        <div class="tf-subrail-section d-none" id="subrail-emails">
            <div class="tf-subrail-header">Hộp thư thông báo</div>
            <div class="tf-subrail-group" id="subrailEmailGroup">
                <!-- Populated dynamically: Tất cả, Nhắc deadline, Giao việc, Hoàn thành task, Lịch sử đã gửi -->
            </div>
        </div>

        <!-- Section for Reviews -->
        <div class="tf-subrail-section d-none" id="subrail-reviews">
            <div class="tf-subrail-header">Đánh giá chéo</div>
            <div class="tf-subrail-group" id="subrailReviewGroup">
                <!-- Populated dynamically: Chờ tôi đánh giá, Đã đánh giá, Kết quả của tôi -->
            </div>
        </div>
    </aside>

    <!-- ==================== ZONE 3: MAIN CONTENT CONTAINER ==================== -->
    <div class="tf-main-container" id="mainContainer">
        <!-- Top Page Header (Clean background matching page) -->
        <header class="tf-page-header">
            <div class="tf-header-left">
                <div class="tf-breadcrumb" id="pageBreadcrumb">TeamFair › Dashboard</div>
                <div class="tf-page-title-row">
                    <button class="tf-back-btn d-none" id="headerBackBtn" onclick="TeamFairApp.switchTab('dashboard')" title="Quay lại Dashboard">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                    </button>
                    <h1 class="tf-page-title" id="pageMainTitle">Dashboard</h1>
                </div>
            </div>

            <div class="tf-header-right">
                <!-- Current Team Badge -->
                <div class="tf-header-team-badge" id="topTeamBadgeContainer" onclick="TeamFairApp.editTeamInfo()" title="Chỉnh sửa thông tin nhóm">
                    <span class="tf-team-dot"></span>
                    <strong id="topTeamName">Chưa có nhóm</strong>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                </div>

                <!-- Join Code Pill Badge -->
                <div class="tf-header-pill cursor-pointer d-none" id="topJoinCodeBadge" onclick="TeamFairApp.copyJoinCode()" title="Bấm để sao chép mã mời">
                    <span class="text-secondary-tf">Mã:</span>
                    <strong id="topJoinCodeText">--</strong>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                </div>

                <!-- Database Status Indicator (Compact Pulsing Dot) -->
                <div id="dbStatusBadge" class="d-inline-flex align-items-center" data-bs-toggle="tooltip" title="Azure SQL: Đã kết nối">
                    <span class="tf-db-dot"></span>
                </div>

                <!-- Dynamic Page Action Buttons Slot -->
                <div class="d-flex align-items-center gap-2" id="pageHeaderActions">
                    <!-- Populated dynamically by JS for active tab -->
                </div>
            </div>
        </header>

        <!-- Page Content Workspace Area -->
        <main class="tf-page-content">

            <!-- TAB 1: DASHBOARD (LEADER & MEMBER) -->
            <div class="tf-tab-pane" id="pane-dashboard">
                <!-- ONBOARDING HUB VIEW (SHOWN WHEN NO TEAM HAS BEEN CREATED YET) -->
                <div id="teamHubView" class="mb-4 d-none">
                    <!-- Welcome & Guide Banner -->
                    <div class="p-4 bg-white rounded-3 border mb-4 shadow-sm">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div>
